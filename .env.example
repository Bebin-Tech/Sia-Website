HOST=127.0.0.1
PORT=3000
DATA_DIR=data
# Set production and your exact HTTPS origin when deploying behind a TLS proxy.
NODE_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:3000
# Optional transactional owner notifications. Never commit actual credentials.
OWNER_EMAIL=
MAIL_FROM=
RESEND_API_KEY=
# Vercel: connect the free Turso integration. Local development uses SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel owner login: paste the JSON generated by npm run setup-admin.
# Store this as a sensitive environment variable, never in Git.
ADMIN_CREDENTIALS=
